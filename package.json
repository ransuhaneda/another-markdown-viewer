{
  "name": "another-markdown-viewer",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "check": "tsc --noEmit",
    "test": "vp test run --exclude 'tests/browser/**'",
    "test:browser": "playwright test",
    "test:browser:headed": "playwright test --headed",
    "build": "vp build",
    "preview": "vp preview",
    "prepare": "vp config"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/markdown": "1.8.1",
    "browser-fs-access": "^0.38.0",
    "dompurify": "^3.4.17",
    "highlight.js": "11.12.0",
    "lucide": "1.61.0",
    "marked": "^18.1.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "jsdom": "^30.1.3",
    "typescript": "~7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  }
}
